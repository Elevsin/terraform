{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],

  "timezone": "Europe/Kyiv",
  "schedule": ["before 6am on monday"],

  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,

  "packageRules": [
    {
      "description": "Все экшены одним PR",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "commitMessageTopic": "GitHub Actions"
    },
    {
      "description": "terraform / tflint / terraform-docs из .tool-versions",
      "matchManagers": ["asdf"],
      "groupName": "tool versions"
    },
    {
      "description": "required_version двигают осознанно, автобампы тут только шумят",
      "matchManagers": ["terraform"],
      "matchDepTypes": ["required_version"],
      "enabled": false
    },
    {
      "description": "Мажоры провайдеров и модулей — только после галочки в Dependency Dashboard",
      "matchManagers": ["terraform"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "bmatcuk/vagrant обновляется редко и ломуче — отдельным PR, без группировки",
      "matchPackageNames": ["bmatcuk/vagrant"],
      "groupName": null
    }
  ]
}
